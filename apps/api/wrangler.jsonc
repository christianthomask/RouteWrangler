{
  // NestJS API on Cloudflare Containers (ADR-019). `wrangler deploy` builds +
  // pushes the root Dockerfile image and deploys the container Worker.
  // BETA / unverified — see worker/index.ts and docs/runbook.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verameter-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "observability": { "enabled": true },

  // Non-secret, non-identifying runtime config (safe to commit — public repo).
  "vars": {
    "NODE_ENV": "production",
    "AUTH_PROVIDER": "neon",
    "STORAGE_PROVIDER": "s3",
    "S3_BUCKET": "verameter-photos",
    "S3_FORCE_PATH_STYLE": "true",
    "S3_REGION": "auto"
  }

  // Instance-specific + secret config is set once via wrangler, NOT here (keeps
  // account ids / issuers / keys out of a public repo):
  //   wrangler secret put DATABASE_URL           (Neon direct connection string)
  //   wrangler secret put NEON_AUTH_BASE_URL      (the branch's Auth URL — issuer,
  //                                                JWKS and audience all derive from it)
  //   wrangler secret put S3_ACCESS_KEY_ID        (R2 access key id)
  //   wrangler secret put S3_SECRET_ACCESS_KEY    (R2 secret)
  //   wrangler secret put S3_ENDPOINT             (https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
  //
  // NEON_AUTH_BASE_URL is not really a secret — the same value is inlined into
  // the web bundle as NEXT_PUBLIC_NEON_AUTH_URL — but it names one specific
  // database branch, so it stays out of a public repo with the rest of the
  // instance config rather than sitting in `vars` above.
}
