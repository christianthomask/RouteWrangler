{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    // No rootDir: this package emits nothing, and the UAT imports the API's
    // seed directly (see main.ts) so its type graph reaches outside src/.
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
