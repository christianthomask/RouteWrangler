# ─────────────────────────────────────────────────────────────────────────────
# RouteWrangler — environment template. Copy to `.env` for local dev.
# Auth and object storage are provider-selectable (ADR-015): the app targets any
# OIDC IdP and any S3-compatible store by config, not code. The defaults below
# run the whole system locally with zero cloud signup (docker Postgres + MinIO +
# the dev-auth shim).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
# IANA zone defining the operational working day. Run dates and "today" are
# calendar dates in the utility's own day — deriving them from UTC rolls the
# date over mid-afternoon in the US and reports in-flight runs as overdue.
APP_TIMEZONE=America/Los_Angeles

# ── Database (docker-compose Postgres for local; Neon Postgres in prod) ─────
DATABASE_URL=postgres://routewrangler:routewrangler@localhost:5432/routewrangler

# ── Auth provider: neon | oidc ─────────────────────────────────────────────
# `neon` is the chosen IdP (ADR-027) and needs exactly one setting. Neon gives
# each database branch its own Auth URL; issuer, JWKS and audience are all
# derived from it, so there is nothing to hand-derive and nothing to get subtly
# wrong. Leave it blank locally and the dev-auth shim below takes over.
AUTH_PROVIDER=neon
NEON_AUTH_BASE_URL=
#   e.g. https://ep-cool-band-123.us-east-2.aws.neon.tech/neondb/auth
#   → issuer + audience = https://ep-cool-band-123.us-east-2.aws.neon.tech
#   → JWKS = <base>/.well-known/jwks.json
#
# Roles are NOT read from the token — the API is DB-authoritative
# (auth/jwt-auth.guard.ts). New staff are invited through Admin → Staff, which
# writes a `users` row with an email and no subject id; the guard attaches the
# identity on that person's first verified sign-in. There is no webhook.

# Generic OIDC escape hatch — any other IdP is config, not code. Set
# AUTH_PROVIDER=oidc and fill these in (JWKS derives from the issuer if omitted).
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=
OIDC_GROUPS_CLAIM=

# ── Local-only auth shim (ADR-012) ──────────────────────────────────────────
# When true AND NODE_ENV != production, the API trusts an `x-dev-user-sub`
# header instead of a JWT, so the simulator/web work without an IdP. Set true
# for local end-to-end runs. HARD-DISABLED in production.
AUTH_DEV_BYPASS=true

# ── Object storage: any S3-compatible store (MinIO locally, R2 in prod) ─────
STORAGE_PROVIDER=s3
# Local MinIO defaults (matches docker-compose).
S3_BUCKET=routewrangler-photos
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-west-2
# Cloudflare R2 (chosen prod storage — same adapter, zero code change).
# Create an R2 bucket + an R2 API token, then:
#   S3_BUCKET=<r2-bucket-name>
#   S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=<r2-access-key-id>
#   S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
#   S3_REGION=auto

# ── Web app (apps/web) — inlined at build time, so set before `next build` ──
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_NEON_AUTH_URL=      # the same URL as NEON_AUTH_BASE_URL above
